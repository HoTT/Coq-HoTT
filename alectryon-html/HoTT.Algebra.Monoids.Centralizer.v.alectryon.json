    {
      "_type": "text",
      "contents": "\n\n(** * Centralizers *)\n\n(** The centralizer of [g] consists of the elements that commute with [g]. We only need a binary operation so this concept is not special to monoids. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition centralizer {A : Type} `{SgOp A} (g h : A)\n  := g * h = h * g.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** A two-sided identity commutes with every element. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition centralizer_unit {A : Type} `{SgOp A} {Aunit : MonUnit A}\n  `{!LeftIdentity _ mon_unit, !RightIdentity _ mon_unit} (g : A) \n  : centralizer g mon_unit\n  := right_identity g @ (left_identity g)^.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** Associativity alone makes each centralizer closed under the operation. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition centralizer_sgop {A : Type} `{SgOp A, !Associative (.*.)} \n  (g h k : A) (p : centralizer g h) (q : centralizer g k)\n  : centralizer g (h * k).",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "centralizer g (h * k)",
          "hypotheses": [
            {
              "_type": "hypothesis",
