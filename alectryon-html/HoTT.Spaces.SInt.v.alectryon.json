    {
      "_type": "text",
      "contents": "\n\n(** By Hedberg's theorem, we have that the signed integers are a set. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Instance ishset_sint@{} : IsHSet SInt := _.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** ** Signed integer induction *)\n\n(** The induction principle for signed integers is similar to the induction principle for natural numbers. However we have two induction hypotheses going in either direction starting from [0].  This is used only in Int.v. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition SInt_ind@{i} (P : SInt -> Type@{i})\n  (H0 : P sint_zero)\n  (HP : forall n : nat, P (sint_of_nat n) -> P (sint_PosS n))\n  (HN : forall n : nat, P (sint_neg (sint_of_nat n)) -> P (sint_NegS n))\n  : forall x, P x.",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "forall x : SInt, P x",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "P"
              ],
              "body": null,
              "type": "SInt -> Type"
            },
            {
              "_type": "hypothesis",
              "names": [
                "H0"
              ],
              "body": null,
              "type": "P sint_zero"
            },
            {
              "_type": "hypothesis",
              "names": [
                "HP"
              ],
              "body": null,
              "type": "forall n : nat, P (sint_of_nat n) -> P (sint_PosS n)"
            },
            {
              "_type": "hypothesis",
              "names": [
                "HN"
              ],
              "body": null,
              "type": "forall n : nat, P (sint_neg (sint_of_nat n)) -> P (sint_NegS n)"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n"
    },
    {
      "_type": "sentence",
      "contents": "Proof.",
      "messages": [],
      "goals": [
