    {
      "_type": "text",
      "contents": "\n\n(** * The signed integers *)\n\n(** In this file, we give a simple inductive type that represents the integers.  It is straightforward to show that this type has decidable equality and is therefore a set, and it is also straightforward to print and parse integers using this type.  However, we only use it for these purposes, and treat the HIT integers as our main definition of the integers, since they have an induction principle with better computational behaviour. *)\n\n(** ** Definition *)\n\n(** We define the signed integers as two copies of [nat] glued together around a [zero].  [sint_NegS n] represents [-(n + 1)] and [sint_PosS n] represents [n+1].  The trailing \"S\" indicates the successor. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Inductive SInt : Type0 :=\n| sint_NegS : nat -> SInt\n| sint_zero : SInt\n| sint_PosS : nat -> SInt.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** We can convert a [nat] to an [SInt] by mapping [0] to [sint_zero] and [S n] to [sint_PosS n]. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_of_nat (n : nat) : SInt :=\n  match n with\n  | O => sint_zero\n  | S n => sint_PosS n\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** Symmetrically, we can send [n] to \"-n\" in this way: *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition negsint_of_nat (n : nat) : SInt :=\n  match n with\n  | O => sint_zero\n  | S n => sint_NegS n\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** ** Parsing and printing *)\n\n(** Here we define some printing and parsing functions that convert the integers between numeral representations.  We don't register these, but they are used for printing and parsing of the HIT integers in Int.v. *)\n\n(** Printing *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_to_number_int (n : SInt) : Numeral.int :=\n  match n with\n  | sint_PosS m => IntDec (Pos (to_uint (S m)))\n  | sint_zero => IntDec (Pos (to_uint 0))\n  | sint_NegS m => IntDec (Neg (to_uint (S m)))\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** Parsing *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_of_number_int (d : Numeral.int) : SInt :=\n  match d with\n  | IntDec (Pos u) => sint_of_nat (of_uint u)\n  | IntDec (Neg u) => negsint_of_nat (of_uint u)\n  | IntHex (Hexadecimal.Pos u) => sint_of_nat (of_hex_uint u)\n  | IntHex (Hexadecimal.Neg u) => negsint_of_nat (of_hex_uint u)\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** ** Successor, predecessor and negation *)\n\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_succ (n : SInt) : SInt :=\n  match n with\n  | sint_PosS n => sint_PosS (S n)\n  | sint_zero => sint_PosS 0\n  | sint_NegS n => negsint_of_nat n\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_pred (n : SInt) : SInt :=\n  match n with\n  | sint_PosS n => sint_of_nat n\n  | sint_zero => sint_NegS 0\n  | sint_NegS n => sint_NegS (S n)\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_neg@{} (x : SInt) : SInt :=\n  match x with\n  | sint_PosS x => sint_NegS x\n  | sint_zero => sint_zero\n  | sint_NegS x => sint_PosS x\n  end.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n(** The successor of a predecessor is the identity. *)\n"
    },
    {
      "_type": "sentence",
      "contents": "Definition sint_succ_pred@{} (x : SInt) : sint_succ (sint_pred x) = x.",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "sint_succ (sint_pred x) = x",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "x"
              ],
              "body": null,
              "type": "SInt"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n"
    },
    {
      "_type": "sentence",
      "contents": "Proof.",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "sint_succ (sint_pred x) = x",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "x"
              ],
              "body": null,
              "type": "SInt"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n  "
    },
    {
      "_type": "sentence",
      "contents": "by destruct x as [ | | []].",
      "messages": [],
      "goals": []
