    {
      "_type": "sentence",
      "contents": "Defined.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n  (** The total space of the Hopf fibration is the 3-sphere. *)\n  "
    },
    {
      "_type": "sentence",
      "contents": "Definition pequiv_hopf_total_s3\n    : psigma (hopf_construction (psphere 1)) <~>* psphere 3\n    := pequiv_pjoin_sphere 1 1 o*E pequiv_hopf_total_join (psphere 1).",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n  (** Since the homotopy groups of the fiber [psphere 1] vanish in degrees 2 and above, the homotopy groups of [psphere 2] and [psphere 3] agree in degrees 3 and above.  The two groups flanking the relevant map in the long exact sequence are homotopy groups of [psphere 1], so [grp_iso_isexact] applies. *)\n  "
    },
    {
      "_type": "sentence",
      "contents": "Definition grp_iso_pi_s2_s3 (n : nat)\n    : Pi n.+3 (psphere 2) $<~> Pi n.+3 (psphere 3).",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "Pi n.+3 (psphere 2) \u2245 Pi n.+3 (psphere 3)",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "H"
              ],
              "body": null,
              "type": "Univalence"
            },
            {
              "_type": "hypothesis",
              "names": [
                "n"
              ],
              "body": null,
              "type": "nat"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n  "
    },
    {
      "_type": "sentence",
      "contents": "Proof.",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "Pi n.+3 (psphere 2) \u2245 Pi n.+3 (psphere 3)",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "H"
              ],
              "body": null,
              "type": "Univalence"
            },
            {
              "_type": "hypothesis",
              "names": [
                "n"
              ],
              "body": null,
              "type": "nat"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n    "
    },
    {
      "_type": "sentence",
      "contents": "refine (groupiso_pi_functor n.+2 pequiv_hopf_total_s3 $oE _^-1$).",
      "messages": [],
      "goals": [
        {
          "_type": "goal",
          "name": null,
          "conclusion": "Pi n.+3 (psigma (hopf_construction (psphere 1))) \u2245 Pi n.+3 (psphere 2)",
          "hypotheses": [
            {
              "_type": "hypothesis",
              "names": [
                "H"
              ],
              "body": null,
              "type": "Univalence"
            },
            {
              "_type": "hypothesis",
              "names": [
                "n"
              ],
              "body": null,
              "type": "nat"
            }
          ]
        }
      ]
    },
    {
      "_type": "text",
      "contents": "\n    "
    },
    {
      "_type": "sentence",
      "contents": "exact (grp_iso_isexact\n             (isexact_pi_total (i_fiberseq fiberseq_hopf) hopf_pr1 n.+3)\n             (isexact_pi_base (i_fiberseq fiberseq_hopf) hopf_pr1 n.+2)).",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n  "
    },
    {
      "_type": "sentence",
      "contents": "Defined.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n  (** The third homotopy group of the 2-sphere is the integers. *)\n  "
    },
    {
      "_type": "sentence",
      "contents": "Definition pi3_s2 : Pi 3 (psphere 2) $<~> abgroup_Z\n    := pin_sn 2 $oE grp_iso_pi_s2_s3 0.",
      "messages": [],
      "goals": []
    },
    {
      "_type": "text",
      "contents": "\n\n"
