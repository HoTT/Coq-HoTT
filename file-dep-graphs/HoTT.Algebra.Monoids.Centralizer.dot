digraph HoTT_Algebra_Monoids_Centralizer {
  graph [ratio=0.5]
  node [style=filled]
Centralizer_centralizer_sgop [label="centralizer_sgop", URL=<Centralizer.html#centralizer_sgop>, peripheries=3, fillcolor="#F070D1"] ;
Centralizer_centralizer_unit [label="centralizer_unit", URL=<Centralizer.html#centralizer_unit>, peripheries=3, fillcolor="#F070D1"] ;
